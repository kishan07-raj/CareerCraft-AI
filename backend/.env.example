
# Backend Environment Variables

# Database (MongoDB Atlas: create free cluster at cloud.mongodb.com)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/careercraft?retryWrites=true&w=majority

# JWT Auth (generate secret: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# Job API (RapidAPI JSearch: https://rapidapi.com/jsearch/api/jsearch-io)
RAPIDAPI_KEY=your-rapidapi-key-here-signup-free

# Server
PORT=8000
NODE_ENV=development

# CORS (update for production frontend URL)
FRONTEND_URL=http://localhost:5173

# Email (optional for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Copy this to .env and fill values before running!

